# OpenAI API 설정 (선택사항 - 없으면 HuggingFace 사용)
#OPENAI_API_KEY=your_openai_api_key_here

# Confluence 설정 (나중에 사용)
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USERNAME=your_email@company.com
CONFLUENCE_API_TOKEN=your_confluence_token

# Jira 설정 (나중에 사용)
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USERNAME=your_email@company.com
JIRA_API_TOKEN=your_jira_token

# Slack 설정 (선택사항)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/11111111/B09FMPX6DUJ/ZGiXWnpdE52SDGwnEQbgLI5E

# 웹 대시보드 설정
DASHBOARD_URL=http://localhost:5000

# 모니터링 설정
WATCH_DIRECTORY=./logs
ERROR_THRESHOLD=3
SUMMARY_INTERVAL=10

# Drain3 설정
DRAIN_SIM_THRESHOLD=0.4
DRAIN_DEPTH=4
DRAIN_MAX_CLUSTERS=1000